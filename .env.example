# SafetyNet Environment Configuration
# Copy to .env and fill in your values

# Casper Network
CASPER_NODE_URL=https://rpc.testnet.casperlabs.io/rpc
CASPER_NETWORK_NAME=casper-test
CHAIN_NAME=casper-test

# Smart Contract (set after deployment)
CONTRACT_HASH=
CONTRACT_PACKAGE=

# Agent Keys (generate with: casper-client keygen ./keys/)
AGENT_SECRET_KEY_PATH=./keys/agent_secret_key.pem
AGENT_PUBLIC_KEY_HEX=

# Agent Behaviour
AGENT_NAME=SafetyNet Alpha v1
STRATEGY_INTERVAL=3600
DEMO_MODE=true

# Logging
LOG_LEVEL=INFO
